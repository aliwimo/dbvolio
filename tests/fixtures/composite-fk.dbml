Table order_items {
  order_id int [not null]
  line_no int [not null]
  product_id int
  indexes {
    (order_id, line_no) [pk]
  }
}

Table orders {
  id int [pk]
  customer_id int
}

Table shipments {
  order_id int [not null]
  warehouse_id int [not null]
  indexes {
    (order_id, warehouse_id) [pk]
  }
}

Ref: order_items.(order_id) > orders.(id)
Ref: shipments.(order_id, warehouse_id) > order_items.(order_id, line_no)
