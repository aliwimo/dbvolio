{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB-Volio",
  "version": "0.1.0",
  "identifier": "com.codevolio.dbvolio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DB-Volio",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["dbml"],
        "name": "DBML Schema",
        "description": "Database Markup Language file",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/plain",
        "exportedType": {
          "identifier": "com.codevolio.dbml",
          "conformsTo": ["public.data", "public.plain-text", "public.text"]
        }
      },
      {
        "ext": ["dbml"],
        "contentTypes": ["public.plain-text", "public.text", "public.data"],
        "name": "DBML Text",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
