{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB-Volio",
  "version": "0.1.1",
  "identifier": "com.codevolio.dbvolio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DB-Volio",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Codevolio",
    "copyright": "Copyright © 2026 Codevolio",
    "shortDescription": "Local-first DBML editor with a live ER diagram.",
    "longDescription": "DB-Volio is a desktop workspace for Database Markup Language (DBML). Open a folder or single .dbml file, edit with syntax highlighting, keep an interactive diagram in sync, and export SQL or images—all without cloud upload.",
    "fileAssociations": [
      {
        "ext": [
          "dbml"
        ],
        "name": "DBML Schema",
        "description": "Database Markup Language file",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}