{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["dbml"],
        "name": "DBML Schema",
        "description": "Database Markup Language file",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/plain",
        "exportedType": {
          "identifier": "com.codevolio.dbml",
          "conformsTo": ["public.data", "public.plain-text", "public.text"]
        }
      },
      {
        "ext": ["dbml"],
        "contentTypes": ["public.plain-text", "public.text", "public.data"],
        "name": "DBML Text",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
